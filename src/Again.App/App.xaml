<Application x:Class="Again.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0D0F12"/>
        <SolidColorBrush x:Key="Panel" Color="#15181D"/>
        <SolidColorBrush x:Key="Panel2" Color="#1B1F25"/>
        <SolidColorBrush x:Key="Text" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="Muted" Color="#9EA7B3"/>
        <SolidColorBrush x:Key="Accent" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="AccentText" Color="#0D0F12"/>
        <SolidColorBrush x:Key="Border" Color="#2A3038"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
